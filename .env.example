# --- Web (apps/web) ---
# mock = Phase A fixtures (default). live = talk to FastAPI (Phase B+).
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- API (apps/api) ---
DATABASE_URL=sqlite:///./data/nova.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nova-dev-change-me
SESSION_SECRET=dev-session-secret-change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_FERNET_KEY=
RUN_REQUESTS_PER_HOUR=40
BUYER_REQUESTS_PER_HOUR=80
LOGIN_REQUESTS_PER_MINUTE=12
SSE_HEARTBEAT_SECONDS=15
ORCHESTRATOR_STEP_DELAY_MS=120
# auto = free-web research + optional LLM key (no mandatory Tavily/WITS/Comtrade)
# stub = no external calls (tests / offline)
PROVIDER_MODE=auto
# Active LLM drives research decisions (not HS-only). Per-version keys via admin.
DEFAULT_LLM_MODEL=gemini-3.8-flash

# Budgets enforced BEFORE tool calls (override: PUT /api/admin/budgets)
# Defaults: max_model_calls=12, max_search_queries=20, max_pages=15, max_wall_seconds=180

# Never put provider API keys in NEXT_PUBLIC_* or commit them here.
# Admin selects active LLM + encrypted per-version key. Saved key ≠ Verified connection.
# Free web: Wikipedia + DuckDuckGo HTML. Never invent web facts.
