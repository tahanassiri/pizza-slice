# --- Web (apps/web) ---
# mock = Phase A fixtures (default). live = talk to FastAPI (Phase B+).
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- API (apps/api) ---
DATABASE_URL=sqlite:///./data/nova.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nova-dev-change-me
SESSION_SECRET=dev-session-secret-change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_FERNET_KEY=
SSE_HEARTBEAT_SECONDS=15
ORCHESTRATOR_STEP_DELAY_MS=120
# auto = free World Bank/Wiki (+ keyed Tavily/Gemini when admin configures keys)
# stub = no external calls (tests / offline)
PROVIDER_MODE=auto

# Never put provider API keys in NEXT_PUBLIC_* or commit them here.
# Admin stores keys encrypted server-side via /api/admin/providers.
